<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_account_move_form_nfe_link" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Smart button: link para a NF-e importada que gerou esta fatura -->
            <div name="button_box" position="inside">
                <button name="action_view_eletronic_document" type="object"
                    class="oe_stat_button" icon="fa-file-text-o"
                    attrs="{'invisible': [('eletronic_doc_id', '=', False)]}">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">NF-e</span>
                        <field name="eletronic_doc_id" class="o_stat_value" nolabel="1"/>
                    </div>
                </button>
            </div>
            <field name="eletronic_doc_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>

</odoo>
